{
  "name": "dsh-plugin-redact",
  "version": "0.1.0",
  "description": "In-place redaction and row-level rollback for DSH session logs (session.vN.jsonl.zstd), usable from inside dsh-tui.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./cordis.patch.tui.yml": "./cordis.patch.tui.yml",
    "./engine": "./lib/engine.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-redact": "./bin/dsh-redact.mjs"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "cordis.patch.tui.yml",
    "lib/engine.mjs",
    "bin/dsh-redact.mjs",
    "test/handler.selftest.mjs",
    "test/preflight.mjs",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "test/torn-recovery.mjs",
    "test/engine.selftest.mjs"
  ],
  "engines": {
    "node": ">=22.15.0"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "session",
    "redact",
    "redaction",
    "tui"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/L-ingqin12/dsh-redaction.git",
    "directory": "packages/dsh-plugin-redact"
  },
  "homepage": "https://github.com/L-ingqin12/dsh-redaction#readme",
  "bugs": {
    "url": "https://github.com/L-ingqin12/dsh-redaction/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-commands": "^0.1.5-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node test/engine.selftest.mjs && node test/handler.selftest.mjs && node test/torn-recovery.mjs && node test/preflight.mjs",
    "prepublishOnly": "npm test"
  }
}
