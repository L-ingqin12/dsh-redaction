{
  "name": "dsh-plugin-content-policy",
  "version": "0.2.0",
  "description": "Preventive content policy for DeepSeek Harness tool results: rewrite matched text with regex rules, or drop/truncate unpredictable payloads by field path before they are normalised, rendered, or persisted. The upstream counterpart to dsh-plugin-redact.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./scrub": "./lib/scrub.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "lib/scrub.mjs",
    "test/selftest.mjs",
    "test/harness.mjs",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/selftest.mjs && node test/harness.mjs",
    "prepublishOnly": "npm test",
    "test:pure": "node test/selftest.mjs",
    "test:config": "node test/config-schemastery.mjs",
    "test:registry": "node test/registry-e2e.mjs"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "content-policy",
    "redaction",
    "prevention",
    "data-minimisation",
    "tool-result"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/L-ingqin12/dsh-redaction.git",
    "directory": "packages/dsh-plugin-content-policy"
  },
  "homepage": "https://github.com/L-ingqin12/dsh-redaction#readme",
  "bugs": {
    "url": "https://github.com/L-ingqin12/dsh-redaction/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
